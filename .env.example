# Copie este archivo como .env y ajuste los valores.
DJANGO_SECRET_KEY=cambie-esta-clave
DJANGO_DEBUG=1
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# PostgreSQL
DB_NAME=vision_segura
DB_USER=postgres
DB_PASSWORD=postgres
DB_HOST=localhost
DB_PORT=5432

# Cámara: 0 = cámara integrada, 1 = cámara USB, o ruta a un video (.mp4/.avi)
FUENTE_CAMARA=0

# Ajustes de detección (opcionales)
CONFIANZA_OBJETOS=0.40
FRAMES_CONFIRMACION=8
ENFRIAMIENTO_SEGUNDOS=30
UMBRAL_MASCARILLA=0.45
UMBRAL_CASCO=0.40
BRILLO_MINIMO=70
